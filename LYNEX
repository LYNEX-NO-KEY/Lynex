local TELEPORT_COOLDOWN = 1.0
local lastTeleportTime = 0
local function teleportToPlayer(targetPlayer, button)
    if not targetPlayer or not targetPlayer.Parent then
        showToast("➤  اللاعب غير متوفر"); return
    end
    if targetPlayer == localPlayer then showToast("➤  لا يمكنك الانتقال إلى نفسك"); return end
    local now = os.clock()
    if now - lastTeleportTime < TELEPORT_COOLDOWN then return end
    lastTeleportTime = now
    local myChar = localPlayer.Character
    local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not (myChar and myHum and myRoot) then
        showToast("➤  شخصيتك غير جاهزة"); return
    end
    if myHum.Health <= 0 then showToast("➤  أنت ميت"); return end
    local targetChar = targetPlayer.Character
    local targetHum  = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not (targetChar and targetHum and targetRoot) then
        showToast("➤  " .. displayNameOf(targetPlayer) .. " ليس لديه شخصية"); return
    end
    if targetHum.Health <= 0 then
        showToast("➤  " .. displayNameOf(targetPlayer) .. " ميت"); return
    end
    local destination = targetRoot.CFrame * CFrame.new(0, 0, 4)
    local ok = pcall(function() myChar:PivotTo(destination) end)
    if not ok then pcall(function() myRoot.CFrame = destination end) end
    showToast("➤  تم الانتقال إلى " .. displayNameOf(targetPlayer))
    if button and button.Parent then
        local origText, origBG = button.Text, button.BackgroundColor3
        button.Text = "➤  …"; button.BackgroundColor3 = THEME.BG_CARD_HI
        task.delay(TELEPORT_COOLDOWN, function()
            if button and button.Parent then
                button.Text = origText; button.BackgroundColor3 = origBG
            end
        end)
    end
end

