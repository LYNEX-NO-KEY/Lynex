local function getUserGameSettings()
    local ok, usFn = pcall(function() return UserSettings end)
    if not ok or not usFn then return nil end
    local ok2, s = pcall(function() return UserSettings():GetService("UserGameSettings") end)
    return ok2 and s or nil
end

local QUALITY_LEVELS = {}
for i = 1, 10 do
    local ok, lvl = pcall(function() return Enum.SavedQualitySetting["QualityLevel" .. i] end)
    if ok and lvl then table.insert(QUALITY_LEVELS, lvl) end
end

local function getCurrentQualityLevel()
    local s = getUserGameSettings()
    if not s then return nil end
    local ok, lvl = pcall(function() return s.SavedQualityLevel end)
    return ok and lvl or nil
end

local function setQualityLevel(lvl)
    local s = getUserGameSettings()
    if not s then return false end
    local ok = pcall(function() s.SavedQualityLevel = lvl end)
    return ok
end

local function getQualityIndex(setting)
    if not setting then return nil end
    for i, lvl in ipairs(QUALITY_LEVELS) do
        if lvl == setting then return i end
    end
    return nil
end

local qualityStatusLbl

local function updateQualityStatus()
    if not qualityStatusLbl then return end
    local lvl = getCurrentQualityLevel()
    if not lvl then
        qualityStatusLbl.Text = "◈ الحالي: غير معروف / تلقائي"
        return
    end
    local idx = getQualityIndex(lvl)
    if idx then
        qualityStatusLbl.Text = "◈ الحالي: المستوى " .. idx .. " / 10"
    else
        qualityStatusLbl.Text = "◈ الحالي: تلقائي"
    end
end

local function captureQualityOriginal()
    if miscState.qualityCaptured then return end
    local lvl = getCurrentQualityLevel()
    if lvl then
        miscState.qualityOriginal = lvl
        miscState.qualityCaptured = true
    end
end

local function increaseQuality()
    captureQualityOriginal()
    local lvl = getCurrentQualityLevel()
    if not lvl then
        pcall(function()
            Lighting.GlobalShadows = true
            Lighting.ShadowSoftness = 0.2
            Lighting.EnvironmentDiffuseScale = 1
            Lighting.EnvironmentSpecularScale = 1
        end)
        showToast("◈  تحسين الجودة (بديل إضاءة)")
        return
    end
    local idx = getQualityIndex(lvl) or 5
    idx = math.min(idx + 1, #QUALITY_LEVELS)
    if setQualityLevel(QUALITY_LEVELS[idx]) then
        updateQualityStatus()
        showToast("◈  الجودة: المستوى " .. idx)
    else
        showToast("✕  لا يمكن تغيير الجودة في هذا المنفذ")
    end
end

local function decreaseQuality()
    captureQualityOriginal()
    local lvl = getCurrentQualityLevel()
    if not lvl then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.ShadowSoftness = 1
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
        showToast("◈  تقليل الجودة (بديل إضاءة)")
        return
    end
    local idx = getQualityIndex(lvl) or 5
    idx = math.max(idx - 1, 1)
    if setQualityLevel(QUALITY_LEVELS[idx]) then
        updateQualityStatus()
        showToast("◈  الجودة: المستوى " .. idx)
    else
        showToast("✕  لا يمكن تغيير الجودة في هذا المنفذ")
    end
end

