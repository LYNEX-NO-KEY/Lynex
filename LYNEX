local function bindCameraToTarget()
    if not spectate.active or not spectate.target then return end
    if not spectate.target.Parent then
        spectate.active = false; spectate.target = nil
        if spectate.connection then
            pcall(function() spectate.connection:Disconnect() end)
            spectate.connection = nil
        end
        local cam = workspace.CurrentCamera
        if cam then
            local myHum = getHumanoid(localPlayer)
            if myHum then cam.CameraSubject = myHum end
        end
        updateSpectateIndicator(); refreshSpectateButtons()
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local hum = getHumanoid(spectate.target)
    if hum then cam.CameraSubject = hum end
end

local function stopSpectating(reason)
    if not spectate.active then return end
    spectate.active = false; spectate.target = nil
    if spectate.connection then
        pcall(function() spectate.connection:Disconnect() end)
        spectate.connection = nil
    end
    local cam = workspace.CurrentCamera
    if cam then
        local myHum = getHumanoid(localPlayer)
        if myHum then
            cam.CameraSubject = myHum
        else
            localPlayer.CharacterAdded:Once(function(char)
                task.wait(0.15)
                if spectate.active then return end
                local newHum = char:FindFirstChildOfClass("Humanoid")
                if newHum and workspace.CurrentCamera then
                    workspace.CurrentCamera.CameraSubject = newHum
                end
            end)
        end
    end
    updateSpectateIndicator(); refreshSpectateButtons()
    if reason and reason ~= "silent" then showToast("◉  " .. reason) end
end

local function startSpectating(targetPlayer)
    if not targetPlayer then return end
    if targetPlayer == localPlayer then showToast("◉  لا يمكنك مشاهدة نفسك"); return end
    if not targetPlayer.Parent then showToast("◉  اللاعب غير متوفر"); return end
    if spectate.active and spectate.target == targetPlayer then stopSpectating(); return end
    if spectate.connection then
        pcall(function() spectate.connection:Disconnect() end)
        spectate.connection = nil
    end
    spectate.active = true; spectate.target = targetPlayer
    local hum = getHumanoid(targetPlayer)
    local cam = workspace.CurrentCamera
    if hum and cam then cam.CameraSubject = hum end
    spectate.connection = targetPlayer.CharacterAdded:Connect(function(char)
        if not spectate.active or spectate.target ~= targetPlayer then return end
        task.wait(0.1)
        if not spectate.active or spectate.target ~= targetPlayer then return end
        local newHum = char:FindFirstChildOfClass("Humanoid")
        if newHum and workspace.CurrentCamera then
            workspace.CurrentCamera.CameraSubject = newHum
        end
    end)
    updateSpectateIndicator(); refreshSpectateButtons()
    local disp = displayNameOf(targetPlayer)
    if hum then showToast("◉  تشاهد " .. disp)
    else showToast("◉  في انتظار " .. disp .. "…") end
end

