local function switchTab(id)
    if currentTab == id then return end
    currentTab = id
    for tid, page in pairs(tabPages) do page.Visible = (tid == id) end
    for tid, data in pairs(tabButtons) do
        local active = (tid == id)
        tween(data.btn, TweenInfo.new(0.2), { BackgroundColor3 = active and THEME.P_MAIN or THEME.BG_CARD })
        data.indicator.Visible = active
        tween(data.icon, TweenInfo.new(0.2), { TextColor3 = active and THEME.TX_MAIN or THEME.P_GLOW })
        tween(data.label, TweenInfo.new(0.2), { TextColor3 = active and THEME.TX_MAIN or THEME.TX_DIM })
    end
    local activeBtn = tabButtons[id] and tabButtons[id].btn
    if activeBtn and sidebar:IsA("ScrollingFrame") then
        local targetY = activeBtn.AbsolutePosition.Y - sidebar.AbsolutePosition.Y
            + sidebar.CanvasPosition.Y
        local maxScroll = math.max(0, sidebar.AbsoluteCanvasSize.Y - sidebar.AbsoluteSize.Y)
        targetY = math.clamp(targetY - 4, 0, maxScroll)
        tween(sidebar, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CanvasPosition = Vector2.new(0, targetY),
        })
    end
    local page = tabPages[id]
    if page then
        animatePageIn(page, id)
        if id == "news" then animateNewsCards() end
        if id == "players" then renderPlayers(searchBox.Text) end
    end
end
