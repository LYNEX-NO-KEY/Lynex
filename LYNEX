local renderBusy, renderPending = false, false
local function renderPlayers(filter)
    if renderBusy then renderPending = true; return end
    renderBusy = true
    for _, child in ipairs(playersList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    filter = tostring(filter or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
    local list = Players:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
    local order = 0
    for _, p in ipairs(list) do
        local matches = filter == ""
            or p.Name:lower():find(filter, 1, true) ~= nil
            or p.DisplayName:lower():find(filter, 1, true) ~= nil
        if matches then order += 1; buildPlayerCard(p, order) end
    end
    if order == 0 then
        create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1,
            Text = "◌  لا يوجد لاعبون مطابقون للبحث",
            Font = FONT.Medium, TextSize = 12, TextColor3 = THEME.TX_SUBTLE,
            TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center,
            LayoutOrder = 0, ZIndex = 5,
        }, playersList)
    end
    renderBusy = false
    if renderPending then renderPending = false; renderPlayers(filter) end
end

