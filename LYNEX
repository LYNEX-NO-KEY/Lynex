-- 16.6) fetchUrl (مشترك)
--==================================================================
local function fetchUrl(url)
    local body = nil

    if typeof(game.HttpGet) == "function" then
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and typeof(res) == "string" and res ~= "" then body = res end
    end

    if not body then
        local reqFunc = (typeof(fluxus) == "table" and typeof(fluxus.request) == "function" and fluxus.request)
            or (typeof(syn) == "table" and typeof(syn.request) == "function" and syn.request)
            or (typeof(http_request) == "function" and http_request)
            or (typeof(request) == "function" and request)
        if reqFunc then
            local ok, resp = pcall(reqFunc, { Url = url, Method = "GET" })
            if ok and typeof(resp) == "table" and typeof(resp.Body) == "string" and resp.Body ~= "" then
                body = resp.Body
            end
        end
    end

    if not body then
        local ok, res = pcall(function()
            return game:GetService("HttpService"):GetAsync(url)
        end)
        if ok and typeof(res) == "string" and res ~= "" then body = res end
    end

    if body then
        local head = body:sub(1, 200):lower()
        if head:find("404: not found", 1, true)
           or head:find("<html", 1, true)
           or head:find("<!doctype", 1, true)
           or #body < 50 then
            warn("[LYNEX fetchUrl] استجابة غير صالحة للرابط:", url)
            return nil
        end
    end

    return body
end

