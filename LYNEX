local function createPage(id, scrolling)
    local class = scrolling and "ScrollingFrame" or "Frame"
    local props = {
        Name = id .. "Page", Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, Visible = false, BorderSizePixel = 0, ZIndex = 4,
