local function styleActionButton(btn, stroke)
    local baseSize = btn.Size
    local pressing = false
    local function scaleTo(f, dur)
        tween(btn, TweenInfo.new(dur), {
            Size = UDim2.new(baseSize.X.Scale * f, baseSize.X.Offset * f,
                             baseSize.Y.Scale * f, baseSize.Y.Offset * f)
        })
    end
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            pressing = true; scaleTo(0.93, 0.08)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            if pressing then pressing = false; scaleTo(1, 0.14) end
        end
    end)
    if UserInputService.MouseEnabled then
        btn.MouseEnter:Connect(function() tween(stroke, TweenInfo.new(0.15), { Transparency = 0.05 }) end)
        btn.MouseLeave:Connect(function() tween(stroke, TweenInfo.new(0.15), { Transparency = 0.25 }) end)
