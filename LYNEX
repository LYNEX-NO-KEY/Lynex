local function getHumanoid(player)
    if not player or not player.Parent then return nil end
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end
local function displayNameOf(player)
    if not player then return "?" end
    local d = player.DisplayName
    if d == nil or d == "" then return player.Name end
    return d
end

local function refreshSpectateButtons()
    for player, refs in pairs(spectateButtons) do
        if refs and refs.btn and refs.btn.Parent then
            local isTarget = (spectate.active and spectate.target == player)
            refs.btn.Text = isTarget and "◉  إيقاف" or "◉  مشاهدة"
            tween(refs.btn, TweenInfo.new(0.2), {
                BackgroundColor3 = isTarget and THEME.DANGER or THEME.P_MAIN,
            })
            if refs.stroke then
                tween(refs.stroke, TweenInfo.new(0.2), {
