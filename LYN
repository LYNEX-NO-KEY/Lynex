local function computeIsSmall()
	local c = cam()
	if c and c.ViewportSize.X > 0 then vp = c.ViewportSize end
	return (vp.X < 820) or (IS_MOBILE and vp.X < vp.Y * 1.25)
end

local function layoutDashboard(small)
	local cardsH = small and CARDS_H_SMALL or CARDS_H_DESK
	CardsRow.Size = UDim2.new(1, 0, 0, cardsH)
	if small then
		CardsGrid.CellSize = UDim2.new(0.5, -px(4), 0, px(84))
	else
		CardsGrid.CellSize = UDim2.new(0.25, -px(6), 0, CARDS_H_DESK)
	end

	local leftH = FEAT_H
	local rightH = SYS_H + px(12) + QA_H
	if not small then rightH = rightH + px(12) + BANNER_H end

	if small then
		LeftCol.Position = UDim2.new(0, 0, 0, 0)
		LeftCol.Size = UDim2.new(1, 0, 0, leftH)
		RightCol.Position = UDim2.new(0, 0, 0, leftH + px(12))
		RightCol.Size = UDim2.new(1, 0, 0, rightH)
	else
		LeftCol.Position = UDim2.new(0, 0, 0, 0)
		LeftCol.Size = UDim2.new(0.615, -px(6), 0, leftH)
		RightCol.Position = UDim2.new(0.615, px(6), 0, 0)
		RightCol.Size = UDim2.new(0.385, -px(6), 0, rightH)
	end

	Banner.Position = UDim2.new(0, 0, 0, SYS_H + px(12) + QA_H + px(12))
	SysCard.Position = UDim2.new(0, 0, 0, 0)
	QACard.Position = UDim2.new(0, 0, 0, SYS_H + px(12))

	local midH = small and (leftH + px(12) + rightH) or math.max(leftH, rightH)
	MidRow.Size = UDim2.new(1, 0, 0, midH)

	LM[Dash] = { h = cardsH + midH, n = 2, gap = px(12) }
	Dash.CanvasSize = UDim2.new(0, 0, 0, cardsH + px(12) + midH + px(14))
end

function applyResponsive()
	isSmall = computeIsSmall()

	if isSmall then
		Shell.Size = screenSize
		Shell.Position = UDim2.new(0, 0, 0, 0)
		Shell.AnchorPoint = Vector2.new(0, 0)
		shellCorner.CornerRadius = UDim.new(0, 0)
		Content.Position = UDim2.new(0, 0, 0, 0)
		Content.Size = screenSize
		Sidebar.Size = UDim2.new(0.76, 0, 1, 0)
		Sidebar.Position = UDim2.new(State.drawer and 0 or -1, 0, 0, 0)
		Pill.Visible = false
		TopBrand.Visible = false
		minBtn.Visible = false
		maxBtn.Visible = false
		closeBtn.Visible = false
		Hamburger.Visible = true
		PageTitle.Position = UDim2.new(0, px(56), 0, px(10))
		PageTitle.Size = UDim2.new(1, -px(70), 0, px(24))
		PageSub.Position = UDim2.new(0, px(56), 0, px(32))
		PageSub.Size = UDim2.new(1, -px(70), 0, px(20))
	else
		Shell.AnchorPoint = Vector2.new(0.5, 0.5)
		Shell.Position = UDim2.new(0.5, State.dragOffset.X, 0.5, State.dragOffset.Y)
		local w = math.min(px(1240), math.floor(vp.X * 0.93))
		local h = math.min(px(780), math.floor(vp.Y * 0.9))
		if State.maximized then
			w = math.floor(vp.X * 0.985)
			h = math.floor(vp.Y * 0.98)
		end
		Shell.Size = UDim2.fromOffset(w, h)
		shellCorner.CornerRadius = UDim.new(0, px(16))
		Content.Position = UDim2.new(SIDEBAR_W, 0, 0, 0)
		Content.Size = UDim2.new(1 - SIDEBAR_W, 0, 1, 0)
		Sidebar.Size = UDim2.new(SIDEBAR_W, 0, 1, 0)
		Sidebar.Position = UDim2.new(0, 0, 0, 0)
		Pill.Visible = true
		TopBrand.Visible = true
		minBtn.Visible = true
		maxBtn.Visible = true
		closeBtn.Visible = true
		Hamburger.Visible = false
		PageTitle.Position = UDim2.new(0, px(20), 0, px(12))
		PageTitle.Size = UDim2.new(0.55, 0, 0, px(24))
		PageSub.Position = UDim2.new(0, px(20), 0, px(34))
		PageSub.Size = UDim2.new(0.55, 0, 0, px(20))
	end

	if not isSmall and State.drawer then
		State.drawer = false
		DrawerDim.Visible = false
	end

	layoutDashboard(isSmall)
end

