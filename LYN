local function navigate(name)
	if not Pages[name] then return end
	CurrentPage = name
	for n, page in pairs(Pages) do
		page.Visible = (n == name)
	end
	PageTitle.Text = name
	PageSub.Text = (PAGE_META[name] and PAGE_META[name].sub) or ""
	refreshNav()
	if isSmall then App.closeDrawer() end
end

