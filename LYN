local function refreshNav()
	for _, item in ipairs(NavList) do
		local active = (item.name == CurrentPage)
		if active then
			item.button.BackgroundColor3 = C.accent
			item.button.BackgroundTransparency = 0.82
			item.label.TextColor3 = C.text
			item.icon.TextColor3 = C.accent2
			item.stroke.Transparency = 0.6
		else
			item.button.BackgroundColor3 = C.accent
			item.button.BackgroundTransparency = 1
			item.label.TextColor3 = C.sub
			item.icon.TextColor3 = C.muted
			item.stroke.Transparency = 1
		end
	end
