-- fly
local flyBV, flyBG
local function stopFly()
	if flyBV then pcall(function() flyBV:Destroy() end); flyBV = nil end
	if flyBG then pcall(function() flyBG:Destroy() end); flyBG = nil end
end

conn(RunService.RenderStepped, function(dt)
	if not getFlag("Fly") then return end
	local hrp, h, c = getRoot(), getHum(), cam()
	if not hrp or not h or not c then return end

	if not flyBV then
		stopFly()
		flyBV = Instance.new("BodyVelocity")
		flyBV.Name = "LYNEX_FlyVelocity"
		flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		flyBV.Velocity = Vector3.zero
		flyBV.Parent = hrp

		flyBG = Instance.new("BodyGyro")
		flyBG.Name = "LYNEX_FlyGyro"
		flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		flyBG.P = 3000
		flyBG.D = 100
		flyBG.CFrame = hrp.CFrame
		flyBG.Parent = hrp

		h.PlatformStand = true
	end

	local speed = getOption("FlySpeed") or 80
	local move = h.MoveDirection
	local dir = c.CFrame:VectorToWorldSpace(Vector3.new(move.X, 0, move.Z))
	if move.Magnitude < 0.05 then dir = Vector3.zero end
	flyBV.Velocity = dir * speed
	flyBG.CFrame = CFrame.new(hrp.Position) * (c.CFrame - c.CFrame.Position)
end)

onChange("Fly", function(on)
	local h = getHum()
	if h then h.PlatformStand = on end
	if not on then stopFly() end
end)

-- ESP
local espList = {}
local function clearESP()
	for char, hl in pairs(espList) do
		pcall(function()
			if hl and hl.Parent then hl:Destroy() end
		end)
		_ = char
	end
	espList = {}
end

local function addESP(char)
	if not char or not char:FindFirstChild("Head") then return end
	if espList[char] then return end
	local hl = Instance.new("Highlight")
	hl.Name = "LYNEX_ESP"
	hl.FillColor = C.accent
	hl.FillTransparency = 0.65
	hl.OutlineColor = C.accent2
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = char
	hl.Parent = char
	espList[char] = hl
end

local function refreshESP()
	clearESP()
	if not getFlag("ESP") then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then addESP(plr.Character) end
	end
end
onChange("ESP", refreshESP)
conn(Players.PlayerAdded, function(plr)
	conn(plr.CharacterAdded, function(char)
		if getFlag("ESP") then addESP(char) end
	end)
end)

-- aimbot
conn(RunService.RenderStepped, function(dt)
	if not getFlag("Aimbot") then return end
	local c = cam()
	if not c then return end

	local best, bestAngle = nil, math.rad(getOption("AimFOV") or 120) / 2
	local mousePos = UIS:GetMouseLocation()
	local ray = c:ViewportPointToRay(mousePos.X, mousePos.Y)
	local origin, lookDir = ray.Origin, ray.Direction.Unit

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local head = plr.Character:FindFirstChild("Head")
			if head then
				local dir = head.Position - origin
				local angle = math.deg(math.acos(math.clamp(dir.Unit:Dot(lookDir), -1, 1)))
				if angle <= bestAngle then
					bestAngle = angle
					best = head
				end
			end
		end
	end

	if best then
		local goal = CFrame.lookAt(c.CFrame.Position, best.Position)
		local t = math.clamp(dt * (getOption("AimSmooth") or 8), 0, 1)
		c.CFrame = c.CFrame:Lerp(goal, t)
	end
end)

