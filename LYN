		Text = tostring(text), TextSize = fs(12), TextColor3 = C.text,
		Position = UDim2.new(0, px(12), 0, 0), Size = UDim2.new(1, -px(20), 1, 0),
		TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
	})
	tween(toast, 0.2, { BackgroundTransparency = 0.06 })
	tween(st, 0.2, { Transparency = 0.5 })
	tween(bar, 0.2, { BackgroundTransparency = 0 })
	tween(txt, 0.2, { TextTransparency = 0 })
	task.delay(2.6, function()
		tween(toast, 0.25, { BackgroundTransparency = 1 })
		tween(st, 0.25, { Transparency = 1 })
		tween(bar, 0.25, { BackgroundTransparency = 1 })
		local t = tween(txt, 0.25, { TextTransparency = 1 })
		t.Completed:Connect(function() toast:Destroy() end)
	end)
end

