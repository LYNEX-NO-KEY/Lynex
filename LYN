		BackgroundColor3 = C.card3, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -px(12), 0.5, 0),
		Size = UDim2.fromOffset(px(44), px(24)),
	}, row)
	corner(track, px(12))

	local knob = make("Frame", {
		BackgroundColor3 = C.text, BorderSizePixel = 0,
		Position = UDim2.new(0, px(3), 0.5, -px(9)),
		Size = UDim2.fromOffset(px(18), px(18)),
	}, track)
	corner(knob, 999)

	local function render(state)
		if state then
			tween(track, 0.16, { BackgroundColor3 = C.accent })
			tween(knob, 0.16, { Position = UDim2.new(1, -px(21), 0.5, -px(9)), BackgroundColor3 = Color3.new(1, 1, 1) })
		else
			tween(track, 0.16, { BackgroundColor3 = C.card3 })
			tween(knob, 0.16, { Position = UDim2.new(0, px(3), 0.5, -px(9)), BackgroundColor3 = C.text })
		end
	end
	onAccent(function(a)
		if Flags[name] then track.BackgroundColor3 = a end
	end)

	local function flip()
		setFlag(name, not getFlag(name))
		if data.callback then data.callback(getFlag(name)) end
	end
	onTap(track, flip)
	onTap(row, function(input)
		local pos = input.Position
		local ap = row.AbsolutePosition
		if pos.X > ap.X + row.AbsoluteSize.X - px(60) then return end
		flip()
	end)

	Flags[name] = data.default == true
	FlagUI[name] = FlagUI[name] or {}
	table.insert(FlagUI[name], { render = render })
	render(Flags[name])
	return row
end

