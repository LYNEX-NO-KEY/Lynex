-- 3.  Scale helpers
--============================================================
local vp = Vector2.new(1280, 720)
do
	local c = cam()
	if c and c.ViewportSize.X > 0 then vp = c.ViewportSize end
end

-- Desktop: keeps the dashboard proportion. Mobile: keeps tap targets readable.
local S
if IS_MOBILE then
	S = math.clamp(math.min(vp.X / 700, vp.Y / 480), 0.9, 1.2)
else
	S = math.clamp(math.min(vp.X / 1150, vp.Y / 720), 0.62, 1.2)
end

local function px(n) return math.max(1, math.floor(n * S + 0.5)) end
local function fs(n) return math.max(9, math.floor(n * S + 0.5)) end
local function touch(n) return math.max(px(n), 40) end

--============================================================
-- 4.  Instance builders
--============================================================
local function make(class, props, parent)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then o[k] = v end
		end
	end
	if parent then o.Parent = parent end
	return o
end

local function corner(obj, r)
	return make("UICorner", { CornerRadius = UDim.new(0, r or px(10)) }, obj)
end

local function stroke(obj, color, thick, transparency)
	return make("UIStroke", {
		Color = color or C.stroke,
		Thickness = thick or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, obj)
end

local function gradient(obj, c1, c2, rotation)
	return make("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 0 }, obj)
end

local function label(parent, props)
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = C.text,
		TextSize = fs(13),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	if props then
		for k, v in pairs(props) do base[k] = v end
	end
	return make("TextLabel", base, parent)
end

local function tween(obj, time, props, style, dir)
	local t = Tween:Create(obj, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function onTap(obj, fn)
	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			fn(input)
		end
	end)
end

--============================================================
-- 5.  Layout engine  (explicit heights, no AutomaticSize)
--============================================================
local LM = {}   -- [frame] = {h = number, n = number, gap = number}
local Conns = {}
local function conn(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Conns, c)
	return c
end

local function track(frame, gap)
	LM[frame] = { h = 0, n = 0, gap = gap or px(8) }
	return frame
end

-- register a child of known height inside a tracked container
local function grow(frame, h)
	local t = LM[frame]
	if not t then return 0 end
	t.h = t.h + h
	t.n = t.n + 1
	return h
end

local function totalH(frame)
	local t = LM[frame]
	if not t then return 0 end
	return t.h + math.max(0, (t.n or 0) - 1) * t.gap
end

