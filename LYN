			Position = UDim2.new(0, px(12), 0, px(26)), Size = UDim2.new(1, -px(76), 0, px(16)),
		})
	end

	local track_ = make("Frame", {
		BackgroundColor3 = C.card3, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -px(12), 0.5, 0),
		Size = UDim2.fromOffset(px(44), px(24)), ZIndex = 6,
	}, row)
