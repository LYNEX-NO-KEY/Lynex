-- 19.  Config system
--============================================================
local CONFIG_FILE = "LYNEX_config.json"

local function buildConfig()
	local flags, options = {}, {}
	for k, v in pairs(Flags) do
		if type(v) == "boolean" then flags[k] = v end
	end
	for k, v in pairs(Options) do
		if type(v) == "number" then options[k] = v end
	end
	return { flags = flags, options = options, version = "1.1.0" }
end

local function saveConfig()
	local ok, json = pcall(function() return HttpService:JSONEncode(buildConfig()) end)
	if not ok then notify("Could not encode config", C.red) return end
	if type(writefile) == "function" then
		local ok2 = pcall(writefile, CONFIG_FILE, json)
		if ok2 then notify("Config saved to " .. CONFIG_FILE, C.green)
		else notify("writefile failed", C.red) end
	else
		_G.LYNEX_CONFIG_CACHE = json
		notify("No writefile here - saved in memory", C.yellow)
	end
end

local function loadConfig()
	local json
	if type(readfile) == "function" and type(isfile) == "function" then
		local okf, has = pcall(isfile, CONFIG_FILE)
		if okf and has then
			local okr, res = pcall(readfile, CONFIG_FILE)
			if okr then json = res end
		end
	elseif _G.LYNEX_CONFIG_CACHE then
		json = _G.LYNEX_CONFIG_CACHE
	end
	if not json then notify("No saved config found", C.yellow) return end

	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(data) ~= "table" then notify("Config is corrupted", C.red) return end

	if type(data.options) == "table" then
		for k, v in pairs(data.options) do
			if type(v) == "number" then
				Options[k] = v
				local list = SliderUI[k]
				if list then
					for _, setter in ipairs(list) do pcall(setter, v, false) end
				end
			end
		end
	end
	if type(data.flags) == "table" then
		for k, v in pairs(data.flags) do
			if Flags[k] ~= nil then setFlag(k, v == true) end
		end
	end
	notify("Config loaded", C.green)
end

