	local knob = make("Frame", {
		BackgroundColor3 = C.text, BorderSizePixel = 0,
		Position = UDim2.new(0, px(3), 0.5, -px(9)),
		Size = UDim2.fromOffset(px(18), px(18)), ZIndex = 7,
	}, track_)
	corner(knob, 999)

	local function render(state)
		if state then
			tween(track_, 0.16, { BackgroundColor3 = C.accent })
			tween(knob, 0.16, { Position = UDim2.new(1, -px(21), 0.5, -px(9)) })
		else
			tween(track_, 0.16, { BackgroundColor3 = C.card3 })
			tween(knob, 0.16, { Position = UDim2.new(0, px(3), 0.5, -px(9)) })
		end
	end
	onAccent(function(a) if Flags[name] then track_.BackgroundColor3 = a end end)

	local function flip()
		setFlag(name, not getFlag(name))
		if data.callback then data.callback(getFlag(name)) end
	end
	onTap(track_, flip)

	local hit = make("TextButton", {
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		Size = UDim2.new(1, -px(66), 1, 0), ZIndex = 7,
	}, row)
	onTap(hit, flip)

	Flags[name] = data.default == true
	FlagUI[name] = FlagUI[name] or {}
	table.insert(FlagUI[name], { render = render })
	render(Flags[name])

	grow(parent, h)
	return row
end

-- slider ------------------------------------------------------
local function addSlider(parent, data)
	local name = data.name
	local minv, maxv = data.min or 0, data.max or 100
	local step = data.step or 1
	local value = data.default or minv
	local h = H.slider

	local row = make("Frame", {
		BackgroundColor3 = C.card2, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, h), ZIndex = 5,
	}, parent)
	corner(row, px(10))
	stroke(row, C.stroke, 1, 0.4)

	label(row, {
		Text = data.title or name, TextSize = fs(13), ZIndex = 6,
		Position = UDim2.new(0, px(12), 0, px(7)), Size = UDim2.new(1, -px(90), 0, px(18)),
	})
	local valLbl = label(row, {
		Text = "", TextSize = fs(12), TextColor3 = C.accent, Font = FONT_BOLD,
		TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6,
		Position = UDim2.new(1, -px(86), 0, px(7)), Size = UDim2.new(0, px(74), 0, px(18)),
	})
	onAccent(function(a) valLbl.TextColor3 = a end)

	local track_ = make("Frame", {
		BackgroundColor3 = C.card3, BorderSizePixel = 0,
		Position = UDim2.new(0, px(12), 0, px(40)),
		Size = UDim2.new(1, -px(24), 0, px(6)), ZIndex = 6,
	}, row)
	corner(track_, px(3))

	local fill = make("Frame", { BackgroundColor3 = C.accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), ZIndex = 7 }, track_)
	corner(fill, px(3))
	onAccent(function(a) fill.BackgroundColor3 = a end)

	local knob = make("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(px(14), px(14)), ZIndex = 8,
	}, track_)
	corner(knob, 999)
	local knobStroke = stroke(knob, C.accent, px(2))
	onAccent(function(a) knobStroke.Color = a end)

	local hit = make("TextButton", {
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		Position = UDim2.new(0, -px(8), 0.5, -px(18)),
		Size = UDim2.new(1, px(16), 0, px(36)), ZIndex = 9,
	}, track_)

	local function apply(v, fire)
		value = math.clamp(v, minv, maxv)
		local rel = (value - minv) / math.max(0.0001, (maxv - minv))
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valLbl.Text = tostring(math.floor(value + 0.5)) .. (data.suffix or "")
		Options[name] = value
		if fire then setOption(name, value) end
		if data.callback then data.callback(value) end
	end

	local dragging = false
	local function fromX(x)
		local rel = (x - track_.AbsolutePosition.X) / math.max(1, track_.AbsoluteSize.X)
		local v = minv + (maxv - minv) * math.clamp(rel, 0, 1)
		v = math.floor(v / step + 0.5) * step
		apply(v, true)
	end

	onTap(hit, function(input) dragging = true; fromX(input.Position.X) end)
	conn(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	conn(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)

	SliderUI[name] = SliderUI[name] or {}
	table.insert(SliderUI[name], apply)
	apply(value, false)

	grow(parent, h)
	return row
end

