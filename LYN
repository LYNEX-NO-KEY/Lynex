local H = {
	toggle    = math.max(touch(52), px(52)),
	toggleSub = math.max(touch(56), px(56)),
	slider    = math.max(touch(58), px(58)),
	button    = math.max(touch(44), px(44)),
	textbox   = math.max(touch(42), px(42)),
	note      = px(22),
	title     = px(26),
	rowGap    = px(8),
	secPad    = px(13),
}

local pendingSections = {}

local function section(parent, title, layoutOrder)
	local card = make("Frame", {
		BackgroundColor3 = C.card,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, px(80)),   -- provisional, fixed in finalize
		LayoutOrder = layoutOrder or 1,
		ZIndex = 4,
	}, parent)
	corner(card, px(12))
	stroke(card, C.stroke, 1)

	local inner = make("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, px(14), 0, H.secPad),
		Size = UDim2.new(1, -px(28), 0, px(10)),
		ZIndex = 5,
	}, card)
	make("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, H.rowGap),
	}, inner)
	track(inner, H.rowGap)

	if title then
		label(inner, {
			Text = title, TextColor3 = C.accent, Font = FONT_BOLD, TextSize = fs(15),
			Size = UDim2.new(1, 0, 0, H.title), LayoutOrder = 0, ZIndex = 6,
		})
		grow(inner, H.title)
	end

	table.insert(pendingSections, { inner = inner, card = card, parent = parent })
	return inner, card
end

-- apply tracked heights of all sections that belong to `parent`
local function finalize(parent)
	for _, s in ipairs(pendingSections) do
		if s.parent == parent and not s.done then
			s.done = true
			local innerH = totalH(s.inner)
			if innerH < px(20) then innerH = px(20) end
			s.inner.Size = UDim2.new(1, -px(28), 0, innerH)
			local cardH = innerH + H.secPad * 2
			s.card.Size = UDim2.new(1, 0, 0, cardH)
			grow(parent, cardH)
		end
	end
end

