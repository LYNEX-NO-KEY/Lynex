local function addButton(parent, data)
	local danger = data.style == "danger"
	local h = H.button
	local b = make("TextButton", {
		BackgroundColor3 = danger and Color3.fromRGB(46, 24, 28) or C.card2,
		BorderSizePixel = 0, AutoButtonColor = false, Text = "",
		Size = UDim2.new(1, 0, 0, h), ZIndex = 5,
	}, parent)
	corner(b, px(10))
	stroke(b, danger and Color3.fromRGB(92, 42, 48) or C.stroke, 1, 0.3)
	label(b, {
		Text = (data.prefix or "") .. (data.title or data.name), TextSize = fs(13),
		TextColor3 = danger and C.red or C.text, TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1), ZIndex = 6,
	})
	b.MouseEnter:Connect(function()
		if not IS_MOBILE then tween(b, 0.15, { BackgroundColor3 = danger and Color3.fromRGB(58, 28, 34) or C.card3 }) end
	end)
	b.MouseLeave:Connect(function()
		if not IS_MOBILE then tween(b, 0.15, { BackgroundColor3 = danger and Color3.fromRGB(46, 24, 28) or C.card2 }) end
	end)
	onTap(b, function()
		tween(b, 0.08, { BackgroundTransparency = 0.3 })
		task.delay(0.1, function() tween(b, 0.15, { BackgroundTransparency = 0 }) end)
		if data.callback then data.callback() end
	end)
	grow(parent, h)
	return b
end

