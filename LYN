local isSmall = false
local function recomputeLayout()
	local c = cam()
	if c then vp = c.ViewportSize end
	computeScale()
	isSmall = (vp.X < 780) or (IS_MOBILE and vp.X < vp.Y * 1.35)

	if isSmall then
		Shell.Size = UDim2.fromScale(1, 1)
		shellCorner.CornerRadius = UDim.new(0, 0)
	else
		local w = math.min(px(1240), math.floor(vp.X * 0.93))
		local h = math.min(px(780), math.floor(vp.Y * 0.9))
		Shell.Size = UDim2.fromOffset(w, h)
		shellCorner.CornerRadius = UDim.new(0, px(16))
	end
end
