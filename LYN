local Flags, Options, FlagUI, SliderUI, Callbacks = {}, {}, {}, {}, {}
local accentListeners = {}

local function onChange(name, fn) Callbacks[name] = fn end
local function onAccent(fn) table.insert(accentListeners, fn) end

local function setFlag(name, value, silent)
	Flags[name] = value
	local list = FlagUI[name]
	if list then
		for _, ui in ipairs(list) do pcall(ui.render, value) end
	end
	if not silent then
		local fn = Callbacks[name]
		if fn then
			task.spawn(function()
				local ok, err = pcall(fn, value)
				if not ok then warn("[LYNEX] " .. tostring(name) .. ": " .. tostring(err)) end
			end)
		end
	end
end

local function getFlag(name) return Flags[name] == true end
local function setOption(name, value)
	Options[name] = value
	local fn = Callbacks["opt:" .. name]
	if fn then task.spawn(function() pcall(fn, value) end) end
end
local function getOption(name) return Options[name] end

local function applyAccent(c)
	C.accent = c
	C.accent2 = Color3.new(
		math.min(1, c.R * 1.22 + 0.06),
		math.min(1, c.G * 1.22 + 0.06),
		math.min(1, c.B * 1.22 + 0.06)
	)
	for _, fn in ipairs(accentListeners) do pcall(fn, C.accent, C.accent2) end
end

