		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if dragging and moved < px(8) then LYNEX_TOGGLE_UI(true) end
			dragging = false
		end
	end)
end

-- drawer (small screens) -------------------------------------
local DrawerDim = make("Frame", {
	Name = "DrawerDim", BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1, BorderSizePixel = 0,
	Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 4,
}, Shell)
onTap(DrawerDim, function() App.closeDrawer() end)

local Hamburger = make("TextButton", {
	BackgroundColor3 = C.card, BorderSizePixel = 0, AutoButtonColor = false,
	Text = "≡", Font = FONT_BOLD, TextSize = fs(18), TextColor3 = C.text,
	Position = UDim2.new(0, px(14), 0, px(16)),
	Size = UDim2.fromOffset(px(32), px(32)),
	Visible = false,
}, Topbar)
corner(Hamburger, px(8))
stroke(Hamburger, C.stroke, 1)
onTap(Hamburger, function()
	if State.drawer then App.closeDrawer() else App.openDrawer() end
end)

function App.openDrawer()
	if not isSmall then return end
	State.drawer = true
	DrawerDim.Visible = true
	DrawerDim.BackgroundTransparency = 1
	tween(DrawerDim, 0.2, { BackgroundTransparency = 0.5 })
	Sidebar.Position = UDim2.new(-1, 0, 0, 0)
	tween(Sidebar, 0.22, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
end

function App.closeDrawer()
	if not State.drawer then return end
	State.drawer = false
	tween(Sidebar, 0.2, { Position = UDim2.new(-1, 0, 0, 0) }, Enum.EasingStyle.Quint)
	local t = tween(DrawerDim, 0.2, { BackgroundTransparency = 1 })
	t.Completed:Connect(function()
		if not State.drawer then DrawerDim.Visible = false end
	end)
end

