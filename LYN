-- 19.  Responsive layout
--============================================================
function applyResponsive()
	recomputeLayout()

	if isSmall then
		Content.Position = UDim2.new(0, 0, 0, 0)
		Content.Size = UDim2.new(1, 0, 1, 0)
		Sidebar.Size = UDim2.new(0.74, 0, 1, 0)
		Sidebar.Position = UDim2.new(State.drawer and 0 or -1, 0, 0, 0)
		CardsGrid.CellSize = UDim2.new(0.5, -px(4), 0, px(80))
		CardsRow.Size = UDim2.new(1, 0, 0, px(80) * 2 + px(8))
	else
		Content.Position = UDim2.new(0.205, 0, 0, 0)
		Content.Size = UDim2.new(0.795, 0, 1, 0)
		Sidebar.Size = UDim2.new(0.205, 0, 1, 0)
		Sidebar.Position = UDim2.new(0, 0, 0, 0)
		CardsGrid.CellSize = UDim2.new(0.25, -px(6), 0, px(86))
		CardsRow.Size = UDim2.new(1, 0, 0, px(86))
	end

	-- topbar adaptation
	local titleX = isSmall and px(56) or px(20)
	PageTitle.Position = UDim2.new(0, titleX, 0, px(12))
	PageSub.Position = UDim2.new(0, titleX, 0, px(34))
	PageTitle.Size = UDim2.new(0.6, 0, 0, px(24))
	Hamburger.Visible = isSmall
	Pill.Visible = not isSmall
	TopBrand.Visible = not isSmall
	Banner.Visible = not isSmall
	for _, b in ipairs(Topbar:GetChildren()) do
		if b:IsA("TextButton") and b ~= Hamburger then
			b.Visible = not isSmall
		end
	end

	-- dashboard columns
	if isSmall then
		LeftCol.Position = UDim2.new(0, 0, 0, 0)
		LeftCol.Size = UDim2.new(1, 0, 0, 0)
		RightCol.Position = UDim2.new(0, 0, 0, LeftCol.AbsoluteSize.Y + px(12))
		RightCol.Size = UDim2.new(1, 0, 0, 0)
		MidRow.Size = UDim2.new(1, 0, 0, LeftCol.AbsoluteSize.Y + RightCol.AbsoluteSize.Y + px(12))
	else
		LeftCol.Position = UDim2.new(0, 0, 0, 0)
		LeftCol.Size = UDim2.new(0.615, -px(6), 0, 0)
		RightCol.Position = UDim2.new(0.615, px(6), 0, 0)
		RightCol.Size = UDim2.new(0.385, -px(6), 0, 0)
		MidRow.Size = UDim2.new(1, 0, 0, math.max(LeftCol.AbsoluteSize.Y, RightCol.AbsoluteSize.Y))
	end
	if State.maximized and not isSmall then
		Shell.Size = UDim2.fromOffset(math.floor(vp.X * 0.985), math.floor(vp.Y * 0.98))
	elseif not isSmall then
		Shell.Size = UDim2.fromOffset(
			math.min(px(1240), math.floor(vp.X * 0.93)),
			math.min(px(780), math.floor(vp.Y * 0.9))
		)
	end
	Shell.Position = UDim2.new(0.5, State.dragOffset.X, 0.5, State.dragOffset.Y)
end

-- keep the dashboard columns height in sync while content grows
do
	local function sync()
		if isSmall then
			RightCol.Position = UDim2.new(0, 0, 0, LeftCol.AbsoluteSize.Y + px(12))
			MidRow.Size = UDim2.new(1, 0, 0, LeftCol.AbsoluteSize.Y + RightCol.AbsoluteSize.Y + px(12))
		else
			MidRow.Size = UDim2.new(1, 0, 0, math.max(LeftCol.AbsoluteSize.Y, RightCol.AbsoluteSize.Y))
		end
	end
	conn(LeftCol:GetPropertyChangedSignal("AbsoluteSize"), sync)
	conn(RightCol:GetPropertyChangedSignal("AbsoluteSize"), sync)
end

--============================================================
-- 20.  Show / hide
--============================================================
local function setUIOpen(open)
	State.uiOpen = open
	if open then
		Shell.Visible = true
		Float.Visible = false
		applyResponsive()
		Shell.BackgroundTransparency = 1
		tween(Shell, 0.18, { BackgroundTransparency = 0 })
	else
		Shell.Visible = false
		Float.Visible = true
		if State.drawer then App.closeDrawer() end
	end
end

function LYNEX_TOGGLE_UI(open)
	setUIOpen(open)
end

--============================================================
-- 21.  Live stats loop
--============================================================
do
	local startClock = os.clock()
	local frames = 0
	conn(RunService.RenderStepped, function() frames = frames + 1 end)

	task.spawn(function()
		while GUI and GUI.Parent do
			local c = cam()
			if c then vp = c.ViewportSize end
			local elapsed = os.clock() - startClock
			local hh = math.floor(elapsed / 3600)
			local mm = math.floor((elapsed % 3600) / 60)
			local ss = math.floor(elapsed % 60)
			local tstr = string.format("%02d:%02d:%02d", hh, mm, ss)
			uptimeValue.Text = tstr
			uptimeRow.Text = tstr
			fpsValue.Text = tostring(math.floor(frames * 2 + 0.5))
			frames = 0
			local okp, ping = pcall(function()
				return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
			end)
			pingValue.Text = okp and string.format("%.0f ms", ping) or "-- ms"
			resValue.Text = string.format("%d x %d", math.floor(vp.X), math.floor(vp.Y))
			task.wait(0.5)
		end
	end)

	conn(workspace:GetPropertyChangedSignal("CurrentCamera"), function() end)
end

--============================================================
-- 22.  Uninject
--============================================================
function LYNEX_UNINJECT()
	for k in pairs(Flags) do
		pcall(setFlag, k, false)
	end
	pcall(stopFly)
	pcall(clearESP)
	pcall(function()
		Lighting.Brightness = DEFAULT.brightness
		Lighting.Ambient = DEFAULT.ambient
		Lighting.OutdoorAmbient = DEFAULT.outdoor
		Lighting.FogEnd = DEFAULT.fogEnd
		Lighting.ClockTime = DEFAULT.clock
		Lighting.GlobalShadows = true
		workspace.Gravity = DEFAULT.gravity
		local c = cam()
		if c then c.FieldOfView = DEFAULT.fov end
	end)
	for _, c in ipairs(Conns) do
		pcall(function() c:Disconnect() end)
	end
	Conns = {}
	_G.LYNEX_LOADED = false
	_G.LYNEX_UNLOAD = nil
	pcall(function() GUI:Destroy() end)
end

_G.LYNEX_UNLOAD = LYNEX_UNINJECT

