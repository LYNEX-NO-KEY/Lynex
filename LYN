local function setLoading(pct, text)
	pct = math.clamp(pct, 0, 1)
	if Load.barFill then
		pcall(function()
			tween(Load.barFill, 0.25, { Size = UDim2.new(pct, 0, 1, 0) })
		end)
	end
	if Load.pctLbl then pcall(function() Load.pctLbl.Text = tostring(math.floor(pct * 100)) .. "%" end) end
	if text and Load.statusLbl then pcall(function() Load.statusLbl.Text = text end) end
end

local function closeLoading()
	if not Load.root then return end
	local r = Load.root
	Load.root = nil
	pcall(function()
		local t = tween(r, 0.35, { BackgroundTransparency = 1 })
		t.Completed:Connect(function()
			pcall(function() r:Destroy() end)
		end)
	end)
end

