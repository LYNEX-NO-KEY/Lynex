	local dragging = false
	local startInput, startOffset
	Topbar.InputBegan:Connect(function(input)
		if isSmall or State.maximized then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = input.Position
			startOffset = State.dragOffset
		end
	end)
	conn(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	conn(UIS.InputChanged, function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - startInput
			State.dragOffset = Vector2.new(startOffset.X + d.X, startOffset.Y + d.Y)
			Shell.Position = UDim2.new(0.5, State.dragOffset.X, 0.5, State.dragOffset.Y)
		end
	end)
