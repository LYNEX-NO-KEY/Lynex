-- ===== دالة إضافة سطر =====
local counter = 0
local allText = {}

local function addLine(text, color)
    counter = counter + 1
    table.insert(allText, text)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -6, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text = counter .. ". " .. text
    lbl.TextColor3 = color or Color3.fromRGB(120, 255, 120)
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 11
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = counter
    lbl.Parent = scroll

    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    scroll.CanvasPosition = Vector2.new(0, layout.AbsoluteContentSize.Y)
end

clearBtn.MouseButton1Click:Connect(function()
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
    allText = {}
    counter = 0
    addLine("تم المسح", Color3.fromRGB(200, 200, 200))
end)

copyBtn.MouseButton1Click:Connect(function()
    local txt = table.concat(allText, "\n")
    if setclipboard then
        pcall(setclipboard, txt)
        copyBtn.Text = "✅ تم النسخ"
        task.wait(1.5)
        copyBtn.Text = "📋 نسخ الكل"
    else
        copyBtn.Text = "❌ غير مدعوم"
        task.wait(1.5)
        copyBtn.Text = "📋 نسخ الكل"
    end
end)

