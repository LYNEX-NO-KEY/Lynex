-- // 2. دالة إضافة النصوص (آمنة للبي سي)
local function addLog(text)
    -- طباعة في الكونسول كخطة بديلة
    print("[LOG]: " .. text)
    
    table.insert(allLogs, text)
    
    -- حماية الذاكرة: إذا زادت الرسائل عن 100، نمسح الأقدم
    if #allLogs > 100 then
        table.remove(allLogs, 1)
        local firstChild = LogFrame:FindFirstChildWhichIsA("TextLabel")
        if firstChild then firstChild:Destroy() end
    end

    -- إنشاء النص
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 0)
    label.AutomaticSize = Enum.AutomaticSize.Y -- يتمدد طولياً حسب النص
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(120, 255, 120)
    label.Font = Enum.Font.Code
    label.TextSize = 13
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.Parent = LogFrame
    
    -- النزول التلقائي للأسفل
    task.defer(function()
        LogFrame.CanvasPosition = Vector2.new(0, LogLayout.AbsoluteContentSize.Y)
    end)
end

