addLine("checkcaller: " .. tostring(hasCheck), hasCheck and Color3.fromRGB(120,255,120) or Color3.fromRGB(255,80,80))
addLine("setclipboard: " .. tostring(setclipboard ~= nil), Color3.fromRGB(200,200,255))

-- ===== Hook FireServer =====
if hasHook then
    local success = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            local m = getnamecallmethod()
            if m == "FireServer" or m == "InvokeServer" then
                local args = {...}
                local parts = {}
                for i, v in ipairs(args) do
                    local ty = typeof(v)
                    if ty == "Instance" then
                        parts[i] = v:GetFullName()
                    elseif ty == "string" then
                        parts[i] = '"'..v..'"'
                    elseif ty == "number" then
                        parts[i] = tostring(v)
                    elseif ty == "boolean" or ty == "nil" then
                        parts[i] = tostring(v)
                    else
                        parts[i] = "<"..ty..">"
                    end
                end
                local path = self:GetFullName()
                local line = "["..m.."] "..path.."("..table.concat(parts, ", ")..")"
                task.spawn(addLine, "🎯 "..line, Color3.fromRGB(255, 130, 255))
            end
            return old(self, ...)
        end)
    end)
    addLine("Hook: "..(success and "✅ شغال" or "❌ فشل"), success and Color3.fromRGB(120,255,120) or Color3.fromRGB(255,80,80))
else
    addLine("❌ hookmetamethod غير مدعوم!", Color3.fromRGB(255,80,80))
end

-- ===== مراقبة Tools =====
local function watchTool(tool)
    if not tool:IsA("Tool") then return end
    addLine("👁 Tool: "..tool.Name, Color3.fromRGB(150,200,255))
    tool.Activated:Connect(function()
        task.spawn(addLine, "🖱 ضربة! Tool: "..tool.Name, Color3.fromRGB(255,255,100))
    end)
end

for _, c in ipairs(LP:GetChildren()) do watchTool(c) end
LP.ChildAdded:Connect(watchTool)
LP.CharacterAdded:Connect(function(char)
    for _, c in ipairs(char:GetChildren()) do watchTool(c) end
    char.ChildAdded:Connect(watchTool)
end)

