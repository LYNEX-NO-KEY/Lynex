-- ======================= منطق الكشف =======================
local isSpying = false
local oldNamecall
local capturedLine = ""

-- دالة لتنسيق الوسائط (Arguments) بشكل مقروء
local function formatArg(v)
    local t = typeof(v)
    if t == "string" then
        return string.format("%q", v)
    elseif t == "Instance" then
        return v:GetFullName()
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then
        return "CFrame.new(...)"
    elseif t == "number" then
        return tostring(v)
    elseif t == "boolean" then
        return tostring(v)
    elseif t == "table" then
        return "{...}"
    else
        return tostring(v)
    end
end

local function startSpy()
    if isSpying then return end
    isSpying = true
    ToggleBtn.Text = "إيقاف الكشف (Stop Spy)"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    LogBox.Text = "الكشف شغال... اضرب اللاعب الآن."

    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        -- نلتقط فقط استدعاءات FireServer
        if method == "FireServer" and not checkcaller() then
            local args = {...}
            local formattedArgs = {}
            for i, v in ipairs(args) do
                formattedArgs[i] = formatArg(v)
            end

            local path = self:GetFullName()
            capturedLine = string.format('%s:FireServer(%s)', path, table.concat(formattedArgs, ", "))

            -- عرض في الواجهة (على Thread رئيسي)
            task.spawn(function()
                LogBox.Text = capturedLine
            end)

            -- (اختياري) إيقاف الكشف تلقائياً بعد أول التقاط
            -- يمكنك تعطيل هذا السطر إذا أردت التقاط عدة أوامر
            -- stopSpy() 
        end

        return oldNamecall(self, ...)
    end)
end

local function stopSpy()
    if not isSpying then return end
    isSpying = false
    ToggleBtn.Text = "بدء الكشف (Start Spy)"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 200)

    if oldNamecall then
        hookmetamethod(game, "__namecall", oldNamecall)
        oldNamecall = nil
    end

    if LogBox.Text == "الكشف شغال... اضرب اللاعب الآن." then
        LogBox.Text = "تم إيقاف الكشف."
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    if isSpying then
        stopSpy()
    else
        startSpy()
    end
end)

-- زر النسخ
CopyBtn.MouseButton1Click:Connect(function()
    if capturedLine ~= "" and setclipboard then
        setclipboard(capturedLine)
        CopyBtn.Text = "تم النسخ ✔"
        task.wait(1.5)
        CopyBtn.Text = "نسخ الأمر (Copy to Clipboard)"
    elseif capturedLine == "" then
        CopyBtn.Text = "لا يوجد أمر لنسخه"
        task.wait(1.5)
        CopyBtn.Text = "نسخ الأمر (Copy to Clipboard)"
    else
        CopyBtn.Text = "setclipboard غير مدعوم"
        task.wait(1.5)
        CopyBtn.Text = "نسخ الأمر (Copy to Clipboard)"
    end
end)

