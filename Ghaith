-- // 2. دالة إضافة نص للسجل
local function addLog(text)
    if text == lastLogText then return end
    lastLogText = text
    task.delay(0.5, function() lastLogText = "" end)

    table.insert(allLogs, text)
    print("[كاشف الأوامر]: " .. text) -- تطبع في الكونسول كخطة بديلة للكمبيوتر
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 30)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.Font = Enum.Font.Code
    label.TextSize = 12
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = LogFrame
    
    LogFrame.CanvasSize = UDim2.new(0, 0, 0, LogLayout.AbsoluteContentSize.Y + 10)
    LogFrame.CanvasPosition = Vector2.new(0, LogLayout.AbsoluteContentSize.Y)
end

-- // 3. أزرار التحكم
ToggleBtn.MouseButton1Click:Connect(function()
    isRecording = not isRecording
    if isRecording then
        ToggleBtn.Text = "إيقاف التسجيل"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        addLog("[النظام] جاهز.. اضرب اللاعب الآن!")
    else
        ToggleBtn.Text = "بدء التسجيل"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        addLog("[النظام] تم إيقاف التسجيل.")
    end
end)

ClearBtn.MouseButton1Click:Connect(function()
    allLogs = {}
    for _, v in pairs(LogFrame:GetChildren()) do
        if v:IsA("TextLabel") then v:Destroy() end
    end
end)

CopyBtn.MouseButton1Click:Connect(function()
    if #allLogs > 0 then
        copyText(table.concat(allLogs, "\n"))
        CopyBtn.Text = "تم النسخ!"
        task.wait(2)
        CopyBtn.Text = "نسخ الكل"
    end
end)

-- // 4. التقاط الأوامر (نسخة محسنة للكمبيوتر)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    -- التحقق مما إذا كان التسجيل مفعل، وأن الأمر هو FireServer، وأنه من اللاعب وليس من اللعبة
    if isRecording and method == "FireServer" and not checkcaller() then
        local args = {...}
        local remoteName = self.Name 
        
        -- استثناء الأوامر المزعجة
        if remoteName ~= "ClientHeartbeat" and remoteName ~= "ServerListAction" then
            local argsString = ""
            for i, v in pairs(args) do
                if typeof(v) ~= "Instance" then 
                    argsString = argsString .. tostring(v) .. ", "
                end
            end
            
            -- استخدام task.spawn لمنع تجميد السكربت أو تعليقه أثناء الالتقاط
            task.spawn(function()
                addLog("الأمر: " .. remoteName .. " | القيم: " .. argsString)
            end)
        end
    end
    
    return oldNamecall(self, ...)
end)
