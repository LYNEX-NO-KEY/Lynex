-- // التقاط الأوامر (باستثناء Heartbeat و Character)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if isRecording then
        local method = getnamecallmethod()
        -- استثناء الأوامر المزعجة فقط
        if (method == "FireServer" or method == "InvokeServer") and self.Name ~= "ClientHeartbeat" and self.Name ~= "Character" then
            local args = {...}
            local argsString = ""
            for i, v in pairs(args) do
                if typeof(v) ~= "Instance" then -- تجاهل الكائنات الطويلة
                    argsString = argsString .. tostring(v) .. ", "
                end
            end
            addLog("الأمر: " .. self.Name .. " | القيم: " .. argsString)
        end
    end
    return oldNamecall(self, ...)
end)

-- // الضرب التلقائي (عبر الأدوات)
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local targetChar = player.Character
            if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("Humanoid") and targetChar.Humanoid.Health > 0 then
                local distance = (myChar.HumanoidRootPart.Position - targetChar.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance and distance <= ATTACK_RANGE then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

RunService.Heartbeat:Connect(function()
    if not isAutoAttacking then return end
    
    local target = getClosestPlayer()
    if target then
        -- محاولة تفعيل الأداة (إذا كنت تحمل أداة ضرب)
        local myChar = LocalPlayer.Character
        local tool = myChar and myChar:FindFirstChildOfClass("Tool")
        
        if tool then
            -- محاكاة النقر على الأداة
            tool:Activate()
            task.wait(0.3) -- سرعة الضرب (يمكنك تقليلها)
        else
            -- إذا لم تكن تحمل أداة، جرّب محاكاة الضغط العادي (اللمس)
            -- بعض الألعاب تتطلب إرسال أمر هنا، سنعرفه من التسجيل
        end
    end
end)
